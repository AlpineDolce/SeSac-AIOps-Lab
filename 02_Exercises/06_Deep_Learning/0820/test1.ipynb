   "source": [
    "from transformers import pipeline\n",
    "\n",
    "# 텍스트 생성 모델 로드\n",
    "generator = pipeline(\"text-generation\", model=\"gpt2\")\n",
    "\n",
    "# 텍스트 생성\n",
    "generated_text = generator(\"Hugging Face is\", max_length=50, num_return_sequences=1)\n",
    "print(generated_text)"
   ]
